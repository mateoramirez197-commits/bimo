# ==========================================
# CONFIGURACION DE ENTORNO (EJEMPLO)
# Copia este archivo como .env y coloca tus credenciales reales
# ==========================================

# Clave API de Groq Cloud (Llama 3.3 / Whisper)
GROQ_API_KEY=tu_clave_groq_aqui

# Modelo por defecto para estructuración clínica
GROQ_MODEL=llama-3.3-70b-versatile

# Configuración Whisper local
WHISPER_MODEL=small
